<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.qoosmo</groupId>
  <artifactId>cryptanalytic-time-memory-tradeoffs</artifactId>
  <version>0.1.0-SNAPSHOT</version>

  <name>Cryptanalytic Time-Memory Tradeoffs</name>
  <description>
    Java reference implementation for reproducible exhaustive-search, Hellman,
    distinguished-point, and exact-coverage research over reduced DES states.
  </description>
  <url>https://github.com/qoosmo/cryptanalytic-time-memory-tradeoffs</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/qoosmo/cryptanalytic-time-memory-tradeoffs/blob/main/LICENSE-MIT</url>
      <distribution>repo</distribution>
    </license>
    <license>
      <name>Apache License 2.0</name>
      <url>https://github.com/qoosmo/cryptanalytic-time-memory-tradeoffs/blob/main/LICENSE-APACHE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Ali Mkhida</name>
      <organization>Algorizk Labs</organization>
      <organizationUrl>https://algorizk.xyz</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/qoosmo/cryptanalytic-time-memory-tradeoffs.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/qoosmo/cryptanalytic-time-memory-tradeoffs.git</developerConnection>
    <url>https://github.com/qoosmo/cryptanalytic-time-memory-tradeoffs</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>17</release>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
    </plugins>
  </build>
</project>
